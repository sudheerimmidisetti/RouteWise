# Django Backend Environment Configuration
SECRET_KEY=django-insecure-spotter-ai-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (Set USE_POSTGRES=True to connect PostgreSQL, otherwise uses SQLite)
USE_POSTGRES=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=spotter_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# OpenRouteService Routing API Key (Optional, falls back to OpenStreetMap OSRM)
ORS_API_KEY=your_openrouteservice_api_key_here

# Configurable FMCSA Driver Daily Log Header Settings
FMCSA_CARRIER_NAME=Spotter Logistics
FMCSA_MAIN_OFFICE_ADDRESS=100 Transport Way, Suite 400, Chicago, IL 60601
FMCSA_DRIVER_NAME=Demo Driver
FMCSA_VEHICLE_NUMBER=TRK-001
FMCSA_SHIPPING_NUMBER=AUTO-0001
FMCSA_CO_DRIVER=N/A
